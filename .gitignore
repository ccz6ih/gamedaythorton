# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
.next/
out/
dist/
build/
next-env.d.ts
tsconfig.tsbuildinfo

# Build output: the prototype is copied here by scripts/copy-prototype.cjs so it
# can be served at /prototype. The source of truth stays in prototype/.
public/prototype/

# Environment — never commit. PILOT_MODE config lives in .env.example only.
.env
.env.*
!.env.example

# Local media uploaded into the prototype (client logos, headshots, photos).
# These may contain likenesses. Keep them out of the repo — the demo stores
# them in the browser's IndexedDB, not on disk.
prototype/assets/uploads/
*.local.json

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Session feedback captures that may contain notes taken in-clinic.
# Commit these deliberately after review, not by accident.
scoping/feedback-*.raw.md

# Vercel CLI local link (contains project/org ids)
.vercel/

.vercel

# Real client data. See private/README.md — the repo is public.
private/*
!private/.gitignore
!private/README.md

.env*.local
.email-preview/
