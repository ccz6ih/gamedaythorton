# ===========================================================================
# .env.example — copy to .env.local and fill in.
#
# .env.local is gitignored. This repository is PUBLIC: never put a real key,
# password, or token in this file or anywhere else that is committed.
#
# Full setup instructions: docs/19-environment.md
# ===========================================================================

# --------------------------------------------------------------- PILOT MODE --
# The master switch. While true:
#   - the "synthetic data only" banner cannot be removed
#   - Stripe refuses to initialise with anything but a test key
#   - the Stripe webhook acknowledges events without applying them
#   - the database rejects any patient row not marked synthetic
#
# Do not set this to false before Phase C sign-off.
# See docs/09-compliance-register.md.
PILOT_MODE=true

# The shared passcode gating this deployment. REQUIRED while PILOT_MODE is true:
# the app refuses to serve anything without it, because an unset passcode would
# silently leave a pre-compliance clinical app publicly browsable.
# Use something long. Change it before sharing the URL.
PILOT_PASSCODE=

# ----------------------------------------------------------------- Supabase --
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-side scripts only (migrate, seed, users, tests). Never needed by the app
# and never exposed to the browser.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_REGION=us-east-1
SUPABASE_DB_PASSWORD=

# Optional overrides if the direct host is unreachable from your network.
# Run `node scripts/db-connect-test.cjs` to find out which route works.
# SUPABASE_DB_HOST=
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres

# Only needed if a background job ever has to bypass RLS. Nothing in the request
# path uses it, and nothing should.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the seeded pilot sign-in accounts (scripts/db-users.cjs).
# Minimum 12 characters. Pilot only — per-user accounts with MFA replace these in
# Phase C, and the accounts themselves get deleted.
PILOT_DEMO_PASSWORD=

# ------------------------------------------------------------------- Stripe --
# TEST KEYS ONLY. lib/stripe.ts refuses to start with a live key while
# PILOT_MODE is true, and will not be talked out of it.
#
#   Dashboard → Developers → API keys (toggle to test mode)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

#   Dashboard → Developers → Webhooks → add endpoint
#   URL: https://YOUR_DEPLOYMENT/api/stripe/webhook
#   Without this, the webhook route returns 503 rather than trusting anything.
STRIPE_WEBHOOK_SECRET=whsec_...

# -------------------------------------------------------------------- other --
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================================================
# NOT SET, ON PURPOSE
#
# There are no SMS or email credentials here. PILOT_MODE logs every message
# instead of sending it, and adding real credentials to a build with no BAAs in
# place would make the first accidental send a reportable event.
#
# Twilio and Resend (or SES) get configured in Phase B, behind the same flag,
# and only sign real BAAs in Phase C. docs/06-architecture.md.
# ===========================================================================
